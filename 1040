
import java.util.*;

class Solution {
    public int[] numMovesStonesII(int[] stones) {
        Arrays.sort(stones);

        int n = stones.length;

        int max = Math.max(
            stones[n - 1] - stones[1] - n + 2,
            stones[n - 2] - stones[0] - n + 2
        );

        int min = n;
        int j = 0;

        for (int i = 0; i < n; i++) {
            while (stones[i] - stones[j] + 1 > n) {
                j++;
            }

            int already = i - j + 1;

            if (already == n - 1 && stones[i] - stones[j] + 1 == n - 1) {
                min = Math.min(min, 2);
            } else {
                min = Math.min(min, n - already);
            }
        }

        return new int[]{min, max};
    }
}
