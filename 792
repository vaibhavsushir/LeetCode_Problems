
class Solution {
    public int numMatchingSubseq(String s, String[] words) {
        int count = 0;

        int[][] next = new int[s.length() + 1][26];

        for (int i = 0; i < 26; i++) {
            next[s.length()][i] = -1;
        }

        for (int i = s.length() - 1; i >= 0; i--) {
            for (int j = 0; j < 26; j++) {
                next[i][j] = next[i + 1][j];
            }

            next[i][s.charAt(i) - 'a'] = i;
        }

        for (String word : words) {
            int pos = 0;
            boolean match = true;

            for (char ch : word.toCharArray()) {
                if (pos > s.length() - 1 || next[pos][ch - 'a'] == -1) {
                    match = false;
                    break;
                }

                pos = next[pos][ch - 'a'] + 1;
            }

            if (match) {
                count++;
            }
        }

        return count;
    }
}
