import java.util.*;

class Solution {
    public int[] getStrongest(int[] arr, int k) {
        Arrays.sort(arr);

        int n = arr.length;
        int median = arr[(n - 1) / 2];

        int left = 0;
        int right = n - 1;

        int[] ans = new int[k];

        for (int i = 0; i < k; i++) {
            if (Math.abs(arr[left] - median) >
                Math.abs(arr[right] - median)) {
                ans[i] = arr[left];
                left++;
            } else {
                ans[i] = arr[right];
                right--;
            }
        }

        return ans;
    }
}
