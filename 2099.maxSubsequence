
import java.util.*;

class Solution {
    public int[] maxSubsequence(int[] nums, int k) {
        int n = nums.length;

        int[][] arr = new int[n][2];

        for (int i = 0; i < n; i++) {
            arr[i][0] = nums[i];
            arr[i][1] = i;
        }

        Arrays.sort(arr, (a, b) -> b[0] - a[0]);

        int[] indices = new int[k];

        for (int i = 0; i < k; i++) {
            indices[i] = arr[i][1];
        }

        Arrays.sort(indices);

        int[] ans = new int[k];

        for (int i = 0; i < k; i++) {
            ans[i] = nums[indices[i]];
        }

        return ans;
    }
}
