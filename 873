
class Solution {
    public int lenLongestFibSubseq(int[] arr) {
        int n = arr.length;
        int[][] dp = new int[n][n];

        int ans = 0;

        for (int j = 0; j < n; j++) {
            for (int k = j + 1; k < n; k++) {
                int target = arr[k] - arr[j];

                int i = java.util.Arrays.binarySearch(arr, 0, j, target);

                if (i >= 0) {
                    dp[j][k] = dp[i][j] + 1;
                    ans = Math.max(ans, dp[j][k] + 2);
                }
            }
        }

        return ans;
    }
}
