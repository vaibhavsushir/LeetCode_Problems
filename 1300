
class Solution {
    public int findBestValue(int[] arr, int target) {
        int left = 0;
        int right = 0;

        for (int num : arr) {
            right = Math.max(right, num);
        }

        int ans = right;
        int diff = Integer.MAX_VALUE;

        while (left <= right) {
            int mid = left + (right - left) / 2;

            int sum = 0;

            for (int num : arr) {
                sum += Math.min(num, mid);
            }

            int currDiff = Math.abs(sum - target);

            if (currDiff < diff || 
                (currDiff == diff && mid < ans)) {
                diff = currDiff;
                ans = mid;
            }

            if (sum < target) {
                left = mid + 1;
            } else {
                right = mid - 1;
            }
        }

        return ans;
    }
}
