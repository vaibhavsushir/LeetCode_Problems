import java.util.*;

class Solution {
    public int[] advantageCount(int[] nums1, int[] nums2) {
        Arrays.sort(nums1);

        int n = nums1.length;
        int[] ans = new int[n];

        Integer[] idx = new Integer[n];

        for (int i = 0; i < n; i++) {
            idx[i] = i;
        }

        Arrays.sort(idx, (a, b) -> nums2[b] - nums2[a]);

        int left = 0;
        int right = n - 1;

        for (int i : idx) {
            if (nums1[right] > nums2[i]) {
                ans[i] = nums1[right];
                right--;
            } else {
                ans[i] = nums1[left];
                left++;
            }
        }

        return ans;
    }
}
