class Solution {
    public int findMaxK(int[] nums) {
        int max = -1;

        for (int num : nums) {
            if (num > 0) {
                for (int x : nums) {
                    if (x == -num) {
                        max = Math.max(max, num);
                        break;
                    }
                }
            }
        }

        return max;
    }
}
