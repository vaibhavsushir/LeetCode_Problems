
class Solution {
    public int[] nextGreaterElements(int[] nums) {
        int n = nums.length;
        int[] ans = new int[n];

        java.util.Arrays.fill(ans, -1);

        java.util.Stack<Integer> st = new java.util.Stack<>();

        for (int i = 2 * n - 1; i >= 0; i--) {
            int idx = i % n;

            while (!st.isEmpty() && st.peek() <= nums[idx]) {
                st.pop();
            }

            if (i < n && !st.isEmpty()) {
                ans[idx] = st.peek();
            }

            st.push(nums[idx]);
        }

        return ans;
    }
}
