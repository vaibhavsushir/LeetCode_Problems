
class Solution {
    public int totalHammingDistance(int[] nums) {
        int ans = 0;
        int n = nums.length;

        for (int i = 0; i < 32; i++) {
            int count = 0;

            for (int num : nums) {
                if ((num & (1 << i)) != 0) {
                    count++;
                }
            }

            ans += count * (n - count);
        }

        return ans;
    }
}
