
class Solution {
    public int[][] spiralMatrixIII(int rows, int cols, int rStart, int cStart) {
        int[][] ans = new int[rows * cols][2];

        int index = 0;
        int steps = 1;

        int r = rStart;
        int c = cStart;

        ans[index][0] = r;
        ans[index++][1] = c;

        while (index < rows * cols) {

            // Move Right
            for (int i = 0; i < steps; i++) {
                c++;
                if (r >= 0 && r < rows && c >= 0 && c < cols) {
                    ans[index][0] = r;
                    ans[index++][1] = c;
                }
            }

            // Move Down
            for (int i = 0; i < steps; i++) {
                r++;
                if (r >= 0 && r < rows && c >= 0 && c < cols) {
                    ans[index][0] = r;
                    ans[index++][1] = c;
                }
            }

            steps++;

            // Move Left
            for (int i = 0; i < steps; i++) {
                c--;
                if (r >= 0 && r < rows && c >= 0 && c < cols) {
                    ans[index][0] = r;
                    ans[index++][1] = c;
                }
            }

            // Move Up
            for (int i = 0; i < steps; i++) {
                r--;
                if (r >= 0 && r < rows && c >= 0 && c < cols) {
                    ans[index][0] = r;
                    ans[index++][1] = c;
                }
            }

            steps++;
        }

        return ans;
    }
}
