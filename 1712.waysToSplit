
class Solution {
    public int waysToSplit(int[] nums) {
        int mod = 1000000007;
        int n = nums.length;

        long[] prefix = new long[n];
        prefix[0] = nums[0];

        for (int i = 1; i < n; i++) {
            prefix[i] = prefix[i - 1] + nums[i];
        }

        long ans = 0;
        int left = 0, right = 0;

        for (int i = 0; i < n - 2; i++) {

            left = Math.max(left, i + 1);

            while (left < n - 1 &&
                   prefix[left - 1] < prefix[i] * 2) {
                left++;
            }

            right = Math.max(right, left);

            while (right < n - 1 &&
                   prefix[right - 1] <=
                   (prefix[i] + prefix[n - 1]) / 2) {
                right++;
            }

            ans = (ans + right - left) % mod;
        }

        return (int) ans;
    }
}
